  lines:
  - text: Good afternoon, Doctor!
    hasChoices: 0
    choices: []
    isEnd: 0
  - text: "Strange plants found around the campus have been collected... That\u2019s
      scary."
    hasChoices: 0
    choices: []
    isEnd: 0
  - text: They have purple particles surrounding them... it almost looks radioactive!
    hasChoices: 0
    choices: []
    isEnd: 0
  - text: "Go into the building and take a look, maybe you\u2019ll be able to help!"
    hasChoices: 0
