  m_Name: QuizNPC1
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - text: I need help with an exame! Can you help me?
    hasChoices: 0
    choices: []
    isEnd: 0
  - text: Basically, I need to know what existed on the Rockefeller campus before
      it became a biomedical research institute...
    hasChoices: 0
    choices: []
    isEnd: 0
  - text: Do you have any guesses?
    hasChoices: 1
    choices:
    - text: Shipyard
      nextIndex: 3
    - text: Sheep farm
      nextIndex: 4
    - text: Manufacturing plant
      nextIndex: 3
    isEnd: 0
  - text: "Hmm, I\u2019m not sure about that... Well, I\u2019ll study a little more!"
    hasChoices: 0
    choices: []
    isEnd: 1
  - text: Of course! Pretty crazy stuff, right? I would never have imagined it.
    hasChoices: 0
    choices: []
    isEnd: 1
