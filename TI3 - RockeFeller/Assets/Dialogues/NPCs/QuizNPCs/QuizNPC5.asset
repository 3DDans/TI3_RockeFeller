  lines:
  - text: "Wow, that\u2019s crazy, Doctor!"
    hasChoices: 0
    choices: []
    isEnd: 0
  - text: This game was developed by people from another country!
    hasChoices: 0
    choices: []
    isEnd: 0
  - text: Take a guess which country.
    hasChoices: 1
    choices:
    - text: United Kingdom
      nextIndex: 3
    - text: Canada
      nextIndex: 3
    - text: Brazil
      nextIndex: 4
    isEnd: 0
  - text: No! It was made by Brazilian game developers!
    hasChoices: 0
    choices: []
    isEnd: 1
  - text: "Yes! That\u2019s incredible, I love that country!"
    hasChoices: 0
    choices: []
    isEnd: 1
