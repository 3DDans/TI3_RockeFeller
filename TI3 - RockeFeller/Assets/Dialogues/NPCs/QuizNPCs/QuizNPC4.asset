  m_Name: QuizNPC4
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - text: Hello, Doctor. I was researching a very renowned university, Rockefeller!
    hasChoices: 0
    choices: []
    isEnd: 0
  - text: Do you want to hear something interesting about it?
    hasChoices: 0
    choices: []
    isEnd: 0
  - text: Which of these employees has Rockefeller ever had?
    hasChoices: 1
    choices:
    - text: A dancer from the Rockettes
      nextIndex: 3
    - text: A famous graffiti artist
      nextIndex: 3
    - text: A B-movie actor
      nextIndex: 3
    isEnd: 0
  - text: "All of the options are correct! Can you believe that? That\u2019s impressive!"
    hasChoices: 0
    choices: []
    isEnd: 1
