  lines:
  - text: "I have a question for you! I doubt you\u2019ll get it right!"
    hasChoices: 0
    choices: []
    isEnd: 0
  - text: Which famous person has NOT appeared on the stage of the Caspary Auditorium,
      the main lecture and presentation hall at The Rockefeller University?
    hasChoices: 1
    choices:
    - text: Hillary Clinton
      nextIndex: 2
    - text: Dalai Lama
      nextIndex: 2
    - text: Kanye West
      nextIndex: 3
    isEnd: 0
  - text: "I knew you wouldn\u2019t get it right! It was Kanye West, bro!"
    hasChoices: 0
    choices: []
    isEnd: 1
  - text: "Oh man! I didn\u2019t think you would get it right..."
    hasChoices: 0
    choices: []
    isEnd: 1
