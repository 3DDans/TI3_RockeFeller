  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - text: "I know it\u2019s a lot, Dr. Stan\u2026 but you\u2019re the only one I
      can trust to handle all of this. "
    hasChoices: 0
    choices: []
    isEnd: 0
  - text: 'Please, begin wherever you think is best. '
    hasChoices: 0
    choices: []
    isEnd: 0
  - text: If you need any assistance, you can find me at the Rector Building, right
      in the center of campus.
    hasChoices: 0
    choices: []
    isEnd: 0
